_G.minSpeed, _G.maxSpeed, _G.curSpeed, _G.sDrag = 0, 300, 300, false

local function updS(v)
    local percentage = math.clamp((v - _G.minSpeed) / (_G.maxSpeed - _G.minSpeed), 0, 1)
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderLabel.Text = "Power: " .. math.floor(v)
end

local function hInp(i)
    local trackWidth = SliderTrack.AbsoluteSize.X
    local trackPos = SliderTrack.AbsolutePosition.X
    local mouseX = i.Position.X
    local percentage = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
    _G.curSpeed = math.floor(math.clamp(_G.minSpeed + (percentage * (_G.maxSpeed - _G.minSpeed)), 0, 300))
    updS(_G.curSpeed)
end

SliderTrack.InputBegan:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then _G.sDrag = true hInp(i) end 
end)
UserInputService.InputChanged:Connect(function(i) 
    if _G.sDrag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then hInp(i) end 
end)
UserInputService.InputEnded:Connect(function(i) 
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then _G.sDrag = false end 
end)

