local CoreGui = game:GetService("CoreGui")
local treadmillState = true
local hiddenTreadmills = {}

local function createBtn(text, order)
    local b = Instance.new("TextButton", Container)
    b.Size = UDim2.new(1, 0, 0, 38)
    b.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    b.Font = Enum.Font.Gotham
    b.Text = text
    b.TextColor3 = Color3.fromRGB(235, 235, 235)
    b.TextSize = 12
    b.LayoutOrder = order
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    return b
end

_G.SpeedBtn = createBtn("Speed: OFF", 2)
_G.TreadBtn = createBtn("Treadmill (Дорожка): ON", 3)

_G.TreadBtn.MouseButton1Click:Connect(function()
    treadmillState = not treadmillState
    if not treadmillState then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and (string.find(string.lower(obj.Name), "treadmill") or string.find(string.lower(obj.Name), "дорож")) then
                hiddenTreadmills[obj] = obj.Parent obj.Parent = CoreGui
            end
        end
        _G.TreadBtn.Text, _G.TreadBtn.TextColor3 = "Treadmill (Дорожка): OFF", Color3.fromRGB(255, 100, 100)
    else
        for obj, originalParent in pairs(hiddenTreadmills) do if obj and originalParent then obj.Parent = originalParent end end
        table.clear(hiddenTreadmills)
        _G.TreadBtn.Text, _G.TreadBtn.TextColor3 = "Treadmill (Дорожка): ON", Color3.fromRGB(235, 235, 235)
    end
end)

-- СТАБИЛЬНЫЙ ФИЗИЧЕСКИЙ СПИДХАК С УДАЛЕНИЕМ HUMANОID И ПЛАВНЫМ WASD УПРАВЛЕНИЕМ ЗА КАМЕРОЙ
local speedActive, velocityConnection = false, nil
_G.SpeedBtn.MouseButton1Click:Connect(function()
    speedActive = not speedActive
    if speedActive then
        _G.SpeedBtn.Text, _G.SpeedBtn.TextColor3 = "Speed: ON", Color3.fromRGB(0, 255, 150)
        
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if humanoid and rootPart then 
            workspace.CurrentCamera.CameraSubject = rootPart 
            humanoid:Destroy() -- Сносим Humanoid для полного байпаса
        end
        
        local lastPauseTime = tick()
        
        velocityConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
            local camera = workspace.CurrentCamera
            
            if root and camera then
                root.Anchored = false
                
                -- Стабильный сброс логов античета: каждые 2 секунды на 10 миллисекунд
                if tick() - lastPauseTime >= 2 then
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    task.wait(0.01)
                    lastPauseTime = tick()
                end
                
                -- Синхронизация направления взгляда за мышью (Shift-Lock эффект)
                local camLook = camera.CFrame.LookVector
                local targetAngle = math.atan2(-camLook.X, -camLook.Z)
                root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, targetAngle, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                -- Считываем WASD кнопки полёта
                local moveDirection = Vector3.new(0, 0, 0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + camera.CFrame.RightVector end
                moveDirection = Vector3.new(moveDirection.X, 0, moveDirection.Z)
                
                if moveDirection.Magnitude > 0 then
                    root.AssemblyLinearVelocity = moveDirection.Unit * _G.curSpeed
                else
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    else
        _G.SpeedBtn.Text, _G.SpeedBtn.TextColor3 = "Speed: OFF", Color3.fromRGB(235, 235, 235)
        if velocityConnection then velocityConnection:Disconnect() velocityConnection = nil end
        
        local character = LocalPlayer.Character local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
        if rootPart then
            task.spawn(function()
                for _, part in pairs(character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
                rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                rootPart.CFrame = CFrame.new(rootPart.Position.X, -450, rootPart.Position.Z)
                LocalPlayer:LoadCharacter() -- Void Reset (Перезапуск через бездну для возврата Humanoid)
            end)
        else
            LocalPlayer:LoadCharacter()
        end
    end
end)

