local function instantClickModify(object)
    if object:IsA("ProximityPrompt") then
        object.HoldDuration = 0 -- Устанавливаем время удержания в 0, чтобы подбирать в один клик
        object.MaxActivationDistance = 15 -- Увеличиваем дистанцию, чтобы брать яйцо чуть дальше
    end
end

-- Сканируем карту на наличие яиц и применяем изменения
for _, desc in pairs(workspace:GetDescendants()) do
    instantClickModify(desc)
end

-- Отслеживаем появление новых яиц на карте
workspace.DescendantAdded:Connect(instantClickModify)
