-- Синхронизированный волновой перелив всей верхней части
RunService.RenderStepped:Connect(function()
    local t = tick() * 4.5
    local synchronousWave = (math.sin(t) + 1) / 2
    local targetColor = Color3.fromRGB(0, 255, 150):Lerp(Color3.fromRGB(255, 255, 255), synchronousWave)
    UIStroke.Color = targetColor
    Title.TextColor3 = targetColor
    SliderFill.BackgroundColor3 = targetColor
end)

_G.minSpeed = 0
_G.maxSpeed = 300
_G.curSpeed = 300
_G.sDrag = false

local function updS(v)
    local percentage = math.clamp((v - _G.minSpeed) / (_G.maxSpeed - _G.minSpeed), 0, 1)
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderLabel.Text = "Power: " .. math.floor(v)
end

local function hInp(i)
    local trackWidth = SliderTrack.AbsoluteSize.X
    local trackPos = SliderTrack.AbsolutePosition.X
    local mouseX = i.Position.X
    
    local percentage = math.clamp((mouseX - trackPos) / trackWidth, 0, 1)
    local rawValue = _G.minSpeed + (percentage * (_G.maxSpeed - _G.minSpeed))
    _G.curSpeed = math.floor(math.clamp(rawValue, 0, 300))
    updS(_G.curSpeed)
end

SliderTrack.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then _G.sDrag = true hInp(i) end end)
UserInputService.InputChanged:Connect(function(i) if _G.sDrag and i.UserInputType == Enum.UserInputType.MouseMovement then hInp(i) end end)
UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then _G.sDrag = false end end)
UserInputService.InputBegan:Connect(function(i, p) if i.KeyCode == Enum.KeyCode.K and not p then ScreenGui.Enabled = not ScreenGui.Enabled end end)

local draggingMenu, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingMenu = true dragStart = input.Position startPos = MainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then draggingMenu = false end end)
    end
end)
MainFrame.InputChanged:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and draggingMenu then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
